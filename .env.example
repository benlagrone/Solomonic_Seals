SOLOMONIC_GUIDED_PROMPTS_API_KEY=
SOLOMONIC_PSALM_SOURCE_MODE=pericope_first
SOLOMONIC_PERICOPE_API_BASE=https://pericopeai.com/api/v1
SOLOMONIC_BILLING_ENFORCEMENT=audit
SOLOMONIC_BILLING_SERVICE_URL=http://127.0.0.1:8090
SOLOMONIC_BILLING_SERVICE_API_KEY=
SOLOMONIC_BILLING_FULFILLMENT_SECRET=
SOLOMONIC_BILLING_STORE_PATH=/var/lib/solomonic-clock/billing_store.json
SOLOMONIC_FREE_VOICE_DAILY_LIMIT=3

